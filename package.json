{
	"name": "pi-sysmon",
	"version": "0.2.0",
	"description": "bottom-style braille system monitor charts (CPU / memory / network) for the pi coding agent",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"system-monitor",
		"tui",
		"braille",
		"charts",
		"bottom",
		"cpu",
		"memory",
		"terminal"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"test": "node --experimental-strip-types test/braille.test.ts",
		"typecheck": "tsc --noEmit",
		"build:single": "node scripts/bundle-single-file.mjs",
		"check": "npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
